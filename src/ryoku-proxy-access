#!/usr/bin/python3 -I
"""Manage an opt-in, local-session-only polkit grant for the Ryoku root helper.

No authorization for arbitrary root commands: this grant applies solely to
org.ryoku.proxy.manage, bound by pkexec to a root-owned helper's exact path.
Anyone running under the authorized account can call that restricted helper;
do not grant access to users you do not trust.
"""
from __future__ import annotations

import grp
import json
import os
import pwd
import re
import stat
import sys
import tempfile
from pathlib import Path

ACTION = 'org.ryoku.proxy.manage'
STATE_DIR = Path('/etc/ryoku-proxy')
STATE_FILE = STATE_DIR / 'authorized-users.json'
RULE_FILE = Path('/etc/polkit-1/rules.d/20-ryoku-proxy-local.rules')
HELPER_DIR = Path('/usr/lib/ryoku-proxy')
HELPER_FILE = HELPER_DIR / 'ryoku-proxy-helper'


def check_user(name: str) -> str:
    if not isinstance(name, str) or not re.fullmatch(r'[a-z_][a-z0-9_-]*\$?', name):
        raise ValueError('Invalid Linux username')
    try:
        record = pwd.getpwnam(name)
    except KeyError as exc:
        raise ValueError('User does not exist: ' + name) from exc
    if record.pw_uid == 0 or record.pw_uid < 1000:
        raise ValueError('Only normal local users (UID >= 1000) may be granted access')
    return name


def check_installation():
    for path in (HELPER_DIR, HELPER_FILE):
        if path.is_symlink():
            raise RuntimeError(f'Symlink in helper path: {path}')
        info = path.stat()
        if info.st_uid != 0 or info.st_mode & (stat.S_IWGRP | stat.S_IWOTH):
            raise RuntimeError(f'Helper must be root-owned and not group/world-writable: {path}')
    if not stat.S_ISREG(HELPER_FILE.stat().st_mode):
        raise RuntimeError('The installed helper is not a regular file')


def load_users():
    if STATE_FILE.is_symlink():
        raise RuntimeError('Refusing symlink for authorized-users.json')
    if not STATE_FILE.exists():
        return []
    data = json.loads(STATE_FILE.read_text('utf-8'))
    if data.get('version') != 1 or not isinstance(data.get('users'), list):
        raise ValueError('Unknown authorization file format')
    names = data['users']
    if len(names) > 32 or any(not isinstance(x, str) or
                              not re.fullmatch(r'[a-z_][a-z0-9_-]*\$?', x) for x in names):
        raise ValueError('Invalid authorization list')
    return sorted(set(names))


def render_rule(names):
    # JSON string literals safely escape usernames for the JavaScript policy.
    users = json.dumps(names, ensure_ascii=True)
    return ("/* Generated by ryoku-proxy-access; do not edit directly. */\n"
            "polkit.addRule(function(action, subject) {\n"
            f"  if (action.id !== {json.dumps(ACTION)}) return;\n"
            "  if (!subject.local || !subject.active) return;\n"
            f"  var users = {users};\n"
            "  if (users.indexOf(subject.user) !== -1) return polkit.Result.YES;\n"
            "});\n")


def atomic_text(path: Path, text: str, mode: int, group: str | None = None):
    path.parent.mkdir(parents=True, exist_ok=True)
    if path.is_symlink():
        raise RuntimeError(f'Refusing to replace symlink {path}')
    fd, tmp = tempfile.mkstemp(prefix='.ryoku-tmp-', dir=str(path.parent))
    try:
        os.fchmod(fd, mode)
        if group is not None:
            try:
                group_id = grp.getgrnam(group).gr_gid
            except KeyError:
                group_id = 0
            os.fchown(fd, 0, group_id)
        with os.fdopen(fd, 'w', encoding='utf-8') as out:
            out.write(text)
            out.flush()
            os.fsync(out.fileno())
        os.replace(tmp, path)
    finally:
        if os.path.exists(tmp):
            os.unlink(tmp)


def save_users(names):
    STATE_DIR.mkdir(mode=0o700, parents=True, exist_ok=True)
    if STATE_DIR.is_symlink() or STATE_DIR.stat().st_uid != 0:
        raise RuntimeError('Authorization directory must be owned by root')
    os.chmod(STATE_DIR, 0o700)
    names = sorted(set(names))
    atomic_text(STATE_FILE, json.dumps({'version': 1, 'users': names}, indent=2) + '\n', 0o600)
    if names:
        atomic_text(RULE_FILE, render_rule(names), 0o644, group='polkitd')
    else:
        if RULE_FILE.is_symlink():
            raise RuntimeError('Refusing to remove symlinked rule')
        RULE_FILE.unlink(missing_ok=True)


def main(argv):
    if os.geteuid() != 0:
        raise PermissionError('Run with sudo (once at setup, or to revoke access)')
    if len(argv) < 2 or argv[1] not in ('grant', 'revoke', 'status'):
        print('Usage: sudo ryoku-proxy-access grant|revoke USER\n'
              '       sudo ryoku-proxy-access status', file=sys.stderr)
        return 2
    op = argv[1]
    if op == 'status' and len(argv) == 2:
        print('Passwordless Ryoku Proxy users: ' + (', '.join(load_users()) or '(none)'))
        return 0
    if op == 'status' or len(argv) != 3:
        raise ValueError('Expected exactly one username')
    check_installation()
    name = check_user(argv[2]) if op == 'grant' else argv[2]
    if op == 'revoke' and not re.fullmatch(r'[a-z_][a-z0-9_-]*\$?', name):
        raise ValueError('Invalid username')
    users = load_users()
    if op == 'grant':
        users.append(name)
    else:
        users = [x for x in users if x != name]
    save_users(users)
    print(f'Ryoku Proxy: {op} completed for {name}. No other polkit actions were changed.')
    return 0


if __name__ == '__main__':
    try:
        sys.exit(main(sys.argv))
    except (ValueError, OSError, RuntimeError, PermissionError, json.JSONDecodeError) as exc:
        print('Ryoku Proxy permission error: ' + str(exc), file=sys.stderr)
        sys.exit(1)
